; Highway Phantom — a daydream at 70 miles per hour.
config_version=5

[application]
config/name="Highway Phantom"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A car-window action daydream. Keep up with the ride."
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.065, 1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=120
